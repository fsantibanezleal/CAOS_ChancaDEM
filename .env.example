# Example environment for an instantiated product. Copy to .env (gitignored) and fill. NO secrets here.
# Most products are static-replay and need NONE of this (the app/ backend is dormant). These vars only matter
# when app/ is activated (ADR-0002 trigger).
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
# CORS origins for the SPA (comma-separated)
DEV_ORIGINS=http://localhost:5173
PROD_ORIGINS=
# where the built SPA + the committed artifacts live (relative to repo root)
FRONTEND_DIST=frontend/dist
DATA_DIR=data/derived
# Required absolute storage roots outside this checkout. Set these in the process
# environment or in .env before initialization/generation; no path is guessed.
CAOS_VENVS_ROOT=
CAOS_DATA_ROOT=
CAOS_MODELS_ROOT=
CAOS_TEMP_ROOT=
# ChancaDEM (scripts/local/workflow.json): the runtimes are <CAOS_VENVS_ROOT>/chancadem/.venv-pipeline and, with
# --notebooks, <CAOS_VENVS_ROOT>/chancadem/.venv-notebooks; the repository's .venv-* aliases must resolve to them.
# 02_generate-data stages under CAOS_TEMP_ROOT. The bake reads only committed tables and models: CAOS_DATA_ROOT is
# not read by it, and CAOS_MODELS_ROOT receives nothing because run.py all never trains (run.py models, local only).
