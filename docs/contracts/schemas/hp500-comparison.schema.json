{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hp500-comparison.schema.json",
  "title": "Hp500Comparison",
  "description": "Catalog row hp500-comparison 1.0.0: the paired comparison of the held-out forecasting methods on the ten HP500 surveys, written by data-pipeline/pipeline/hp500/comparison.py to data/derived/hp500/comparison.json from hp500-loo and, when present, hp500-crusherbayes (read only). Per measured target (throughput tph [t/h], power kW [kW]): the measured values, every method with its document MAPE and its ten held-out absolute percent errors, the recommended method (the lowest document MAPE among the methods that are not controls) and the runner-up (the next lowest), and for every method with predictions its paired difference against the recommended one: d_i = APE_i(method) - APE_i(recommended) in percentage points (positive: the method is worse), the mean of d, its 95 percent percentile bootstrap interval over the surveys (numpy.random.default_rng(seed).integers(0, n, size=(resamples, n)), the mean of d over each resample, the 2.5 and 97.5 percent quantiles: the resampling of the CrusherBayes manuscript), wins (the surveys where the recommended method has the strictly lower APE) and p_better (the share of resamples whose mean is above 0). The label-shuffle control has no per-survey predictions and carries no paired row. With hp500-crusherbayes absent, crusherbayes.included is false, its note says so and no CrusherBayes row appears. Rules the schema cannot state, checked by the producer test: n equals the length of every per-survey list; recommended and runner_up name methods that are not controls, recommended has the lowest mape_pct and runner_up the next; every paired row's against is the recommended method; ci95 low is at most mean_diff_pts and high at least it; the document is byte-identical for the same inputs. Derived from data licensed CC BY 4.0 (https://doi.org/10.3390/min14090919).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "engine_version",
    "n",
    "bootstrap",
    "inputs",
    "crusherbayes",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "chancadem.hp500.comparison/v1"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "engine_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}\\.\\d{3}$"
    },
    "n": {
      "type": "integer",
      "minimum": 3
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "resamples",
        "seed",
        "quantiles"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "resamples": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer"
        },
        "quantiles": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loo",
        "crusherbayes"
      ],
      "properties": {
        "loo": {
          "$ref": "#/$defs/input"
        },
        "crusherbayes": {
          "oneOf": [
            {
              "$ref": "#/$defs/input"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "crusherbayes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "note"
      ],
      "properties": {
        "included": {
          "type": "boolean"
        },
        "note": {
          "oneOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tph",
        "kW"
      ],
      "properties": {
        "tph": {
          "$ref": "#/$defs/target"
        },
        "kW": {
          "$ref": "#/$defs/target"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "engine_version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "engine_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d{2}\\.\\d{3}$"
        }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "control",
        "mape_pct",
        "ape_pct"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "control": {
          "type": "boolean"
        },
        "mape_pct": {
          "type": "number",
          "minimum": 0
        },
        "ape_pct": {
          "oneOf": [
            {
              "$ref": "#/$defs/series"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "paired": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "against",
        "mean_diff_pts",
        "ci95",
        "wins",
        "p_better"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "against": {
          "type": "string",
          "minLength": 1
        },
        "mean_diff_pts": {
          "type": "number"
        },
        "ci95": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2
        },
        "wins": {
          "type": "integer",
          "minimum": 0
        },
        "p_better": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "methods",
        "recommended",
        "runner_up",
        "paired"
      ],
      "properties": {
        "measured": {
          "$ref": "#/$defs/series"
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          },
          "minItems": 2
        },
        "recommended": {
          "type": "string",
          "minLength": 1
        },
        "runner_up": {
          "type": "string",
          "minLength": 1
        },
        "paired": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paired"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "doi",
        "license",
        "table"
      ],
      "properties": {
        "paper": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "const": "10.3390/min14090919"
        },
        "license": {
          "const": "CC BY 4.0"
        },
        "table": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
